#!/usr/bin/env python3
"""sofle-layerd - publish the Sofle's active QMK layer for the Omarchy bar.

The keyboard's firmware (keymaps/radbug, CONSOLE_ENABLE) prints
"sofle layer=N" on its QMK debug console (HID usage page 0xFF31, usage 0x74)
every time the active layer changes. This daemon reads that console and
mirrors the newest value into $XDG_RUNTIME_DIR/sofle-layer, which the
alvarosaavedra.sofle-layer bar widget watches.

Re-scans /sys/class/hidraw every couple of seconds, so a keyboard that is
unplugged, replugged, or not yet flashed with console support is picked up
whenever it appears. Base layer (0) is assumed until the keyboard speaks;
layer keys are momentary, so holding one re-publishes the state anyway.
"""

import glob
import os
import re
import select
import sys
import time

HID_ID = "0000FC32:00000287"  # JosefAdamcik Sofle: fc32:0287
USAGE_PAGE = "0xff31"  # QMK debug console
USAGE = "0x74"
LINE_RE = re.compile(rb"sofle layer=(\d+)")
SCAN_INTERVAL = 2.0

RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
STATE_PATH = os.path.join(RUNTIME, "sofle-layer")


def is_console_device(sysdir):
    """True if the hidraw's report descriptor declares the QMK debug
    console (usage page 0xFF31, usage 0x74). The usage_page/usage sysfs
    files don't exist on every kernel, so parse the descriptor bytes."""
    try:
        with open(os.path.join(sysdir, "report_descriptor"), "rb") as f:
            desc = f.read()
    except OSError:
        return False
    i = 0
    page_ok = False
    while i < len(desc):
        if desc[i] == 0x06 and i + 2 < len(desc):  # global usage page (16-bit LE)
            page_ok = desc[i + 1] == 0x31 and desc[i + 2] == 0xFF
            i += 3
        elif desc[i] == 0x09 and i + 1 < len(desc):  # local usage
            if page_ok and desc[i + 1] == 0x74:
                return True
            i += 2
        else:
            i += 1
    return False


def find_console_device():
    for link in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        try:
            with open(os.path.join(link, "device", "uevent")) as f:
                uevent = f.read()
        except OSError:
            continue
        if HID_ID in uevent and is_console_device(os.path.join(link, "device")):
            return "/dev/" + os.path.basename(link)
    return None


def write_state(value):
    tmp = STATE_PATH + ".tmp"
    with open(tmp, "w") as f:
        f.write(str(value))
    os.replace(tmp, STATE_PATH)


def drain(buffer, current):
    """Consume complete 'sofle layer=N' lines; returns (buffer, newest)."""
    while True:
        m = LINE_RE.search(buffer)
        if not m:
            # Keep a tail: a line can straddle two HID reports.
            return buffer[-24:], current
        current = int(m.group(1))
        buffer = buffer[m.end():]


def follow(device):
    """Read the console until the device goes away. Returns last layer."""
    buffer = b""
    current = None
    fd = os.open(device, os.O_RDONLY)
    try:
        while True:
            ready, _, _ = select.select([fd], [], [], SCAN_INTERVAL)
            if not ready:
                if not os.path.exists(device):
                    return current
                continue
            try:
                chunk = os.read(fd, 32)
            except OSError:
                return current
            if not chunk:
                return current
            buffer, current = drain(buffer + chunk, current)
            if current is not None:
                write_state(current)
    finally:
        os.close(fd)


def main():
    write_state(0)
    print(f"sofle-layerd: publishing to {STATE_PATH}", file=sys.stderr)
    while True:
        device = find_console_device()
        if not device:
            time.sleep(SCAN_INTERVAL)
            continue
        print(f"sofle-layerd: reading {device}", file=sys.stderr)
        try:
            follow(device)
        except OSError as e:
            print(f"sofle-layerd: {device}: {e}", file=sys.stderr)
        print("sofle-layerd: device lost, rescanning", file=sys.stderr)
        time.sleep(SCAN_INTERVAL)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
